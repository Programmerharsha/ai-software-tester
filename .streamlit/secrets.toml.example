# Streamlit Secrets Template for Online Deployment
# In Streamlit Community Cloud: Go to App Settings -> Secrets -> Paste your secrets below.

# ── Active AI Provider ────────────────────────────────────────────────────────
# Options: "gemini" | "groq" | "openai" | "ollama" | "demo"
AI_PROVIDER = "gemini"

# ── Google Gemini (Recommended for free cloud hosting) ────────────────────────
# Get free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"
# GEMINI_MODEL = "gemini-1.5-flash"  # default: gemini-1.5-flash

# ── Groq Cloud (Ultra-fast inference with free tier) ──────────────────────────
# Get free API key: https://console.groq.com/keys
# GROQ_API_KEY = "gsk_..."
# GROQ_MODEL = "llama-3.3-70b-versatile"  # or qwen-2.5-coder-32b

# ── OpenAI / OpenRouter / DeepSeek ────────────────────────────────────────────
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# ── Remote Ollama (if hosting Ollama via Ngrok or Cloud VPS) ──────────────────
# OLLAMA_URL = "https://your-ngrok-or-cloud-url.com"
# AI_MODEL = "qwen2.5-coder:7b"
